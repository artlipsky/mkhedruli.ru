---
import { Card } from "@heroui/react";
import { ALPHABET } from "../react/Georgian/letters";
---

<Card variant="default" className="p-0 rounded-xl overflow-hidden">
  <table class="w-full text-sm border-collapse table-fixed">
    <caption class="sr-only">
      Все 33 буквы грузинского алфавита мхедрули с названиями и русской транскрипцией
    </caption>
    <colgroup>
      <col class="w-14 sm:w-20" />
      <col class="w-20 sm:w-32" />
      <col class="w-14 sm:w-24" />
      <col />
    </colgroup>
    <thead>
      <tr class="text-[0.65rem] text-muted sm:text-xs uppercase tracking-wide">
        <th scope="col" class="px-2 sm:px-4 py-3 font-medium text-center">Буква</th>
        <th scope="col" class="px-2 sm:px-4 py-3 font-medium text-left">Название</th>
        <th scope="col" class="px-2 sm:px-4 py-3 font-medium text-left">Звук</th>
        <th scope="col" class="px-2 sm:px-4 py-3 font-medium text-left">Произношение</th>
      </tr>
    </thead>
    <tbody>
      {
        ALPHABET.map(({ ka, name, ru, note }) => (
          <tr class="border-border border-t">
            <th
              scope="row"
              class="px-2 sm:px-4 py-2 font-georgian font-normal text-2xl text-center align-middle"
            >
              {ka}
            </th>
            <td class="px-2 sm:px-4 py-2 text-muted align-middle">{name}</td>
            <td class="px-2 sm:px-4 py-2 font-medium align-middle">{ru}</td>
            <td class="px-2 sm:px-4 py-2 text-muted text-xs sm:text-sm align-middle">{note}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Card>
