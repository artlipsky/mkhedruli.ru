---
import { FAQ_ITEMS } from "../../data/faq";
---

<div class="flex flex-col gap-4">
  {
    FAQ_ITEMS.map(({ q, a }) => (
      <details class="group bg-background-secondary open:bg-background-secondary border border-border rounded-2xl">
        <summary class="flex justify-between items-center gap-4 px-5 py-4 font-medium cursor-pointer list-none">
          <h3 class="font-sans font-medium text-base tracking-normal">{q}</h3>
          <span
            aria-hidden
            class="text-muted transition-transform group-open:rotate-45 shrink-0 text-xl leading-none"
          >
            +
          </span>
        </summary>
        <p class="px-5 pb-5 text-muted text-sm md:text-base">{a}</p>
      </details>
    ))
  }
</div>
