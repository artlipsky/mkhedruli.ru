---
import Layout from "../layouts/Layout.astro";
import { GeorgianTrainer } from "../components/react/Georgian";
---

<Layout
  title="Georgian Letters — flashcards"
  description="Learn Georgian letters with flashcards: pick the matching Russian sound."
>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+Georgian:wght@400&display=swap"
  />
  <main class="flex flex-col justify-center items-center gap-12 p-4 md:p-8 min-h-screen">
    <div class="flex flex-col items-center gap-3 max-w-2xl text-center">
      <h1 class="font-semibold text-3xl md:text-5xl text-balance">Georgian Letters</h1>
      <p class="text-muted text-sm md:text-base text-balance">
        Pick the Russian sound that matches the letter.
      </p>
    </div>

    <GeorgianTrainer client:load />
  </main>
</Layout>
