---
import Layout from "../layouts/Layout.astro";
import AlphabetTable from "../components/astro/AlphabetTable.astro";
import { Faq } from "../components/react/Faq";
import { GeorgianTrainer } from "../components/react/Georgian";
import { FAQ_ITEMS } from "../data/faq";

const title = "Грузинский алфавит: тренажёр букв мхедрули онлайн";
const description =
  "Бесплатный тренажёр грузинского алфавита: 33 буквы мхедрули с русской транскрипцией, карточки по шести уровням и таблица произношения. Без регистрации.";

const site = Astro.site!.toString().replace(/\/$/, "");

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: `${site}/`,
      name: "mkhedruli.ru",
      description,
      inLanguage: "ru-RU",
    },
    {
      "@type": "WebApplication",
      "@id": `${site}/#app`,
      name: "Тренажёр грузинского алфавита",
      url: `${site}/`,
      description,
      applicationCategory: "EducationalApplication",
      operatingSystem: "Web",
      browserRequirements: "Требуется JavaScript",
      inLanguage: "ru-RU",
      isAccessibleForFree: true,
      isPartOf: { "@id": `${site}/#website` },
      offers: { "@type": "Offer", price: "0", priceCurrency: "RUB" },
    },
    {
      "@type": "LearningResource",
      "@id": `${site}/#course`,
      name: "Буквы грузинского алфавита мхедрули",
      url: `${site}/`,
      learningResourceType: "Флеш-карточки",
      educationalLevel: "Начальный",
      teaches: "Чтение букв грузинского алфавита мхедрули и их произношение",
      inLanguage: "ru-RU",
      isAccessibleForFree: true,
      about: { "@type": "Thing", name: "Грузинский алфавит (мхедрули)" },
    },
    {
      "@type": "FAQPage",
      "@id": `${site}/#faq`,
      mainEntity: FAQ_ITEMS.map(({ q, a }) => ({
        "@type": "Question",
        name: q,
        acceptedAnswer: { "@type": "Answer", text: a },
      })),
    },
  ],
};
---

<Layout title={title} description={description}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <main class="flex flex-col items-center gap-20 md:gap-28 mx-auto px-4 md:px-8 py-16 w-full max-w-3xl">
    <section class="flex flex-col items-center gap-12 w-full">
      <div class="flex flex-col items-center gap-3 text-center">
        <h1 class="font-semibold text-3xl md:text-5xl text-balance">
          Тренажёр грузинского алфавита
        </h1>
        <p class="text-muted text-sm md:text-base text-balance">
          Выберите русский звук, который соответствует букве мхедрули. Шесть уровней — от гласных
          до полного набора пройденных букв.
        </p>
      </div>

      <GeorgianTrainer client:load />
    </section>

    <section id="alphabet" class="flex flex-col gap-6 w-full scroll-mt-8">
      <div class="flex flex-col gap-3">
        <h2 class="font-semibold text-2xl md:text-3xl text-balance">
          Грузинский алфавит с русской транскрипцией
        </h2>
        <p class="text-muted text-sm md:text-base">
          Полная таблица всех 33 букв мхедрули в алфавитном порядке: начертание, традиционное
          название буквы и звук, которым она читается. Придыхательные согласные записаны как
          «тх», «кх», «пх» — так их проще отличить от резких абруптивов.
        </p>
      </div>
      <AlphabetTable />
    </section>

    <section id="about" class="flex flex-col gap-4 w-full scroll-mt-8">
      <h2 class="font-semibold text-2xl md:text-3xl text-balance">Как устроено письмо мхедрули</h2>
      <div class="flex flex-col gap-4 text-muted text-sm md:text-base">
        <p>
          Мхедрули — третья и последняя из грузинских письменностей. Первой в V веке появилось
          асомтаврули, затем из него развилось церковное нусхури, а с X века складывается
          мхедрули, которым грузины пишут до сих пор. Все три системы ЮНЕСКО внесла в список
          нематериального культурного наследия.
        </p>
        <p>
          Для человека, знающего русский, алфавит удобен тем, что письмо строго фонетическое:
          буква всегда читается одинаково, немых букв нет, ударение не меняет звучание гласных.
          Заглавных букв в мхедрули тоже нет — у каждой буквы одно начертание, и запоминать
          приходится вдвое меньше, чем в кириллице или латинице.
        </p>
        <p>
          Главная сложность — согласные, которых нет в русском. Грузинский различает абруптивы
          (резкий звук без выдоха) и придыхательные (с заметным выдохом): ტ и თ, კ и ქ, პ и ფ.
          В русском ухе обе буквы пары звучат почти одинаково, поэтому в тренажёре есть отдельный
          уровень, где они показываются парой — так разница запоминается быстрее.
        </p>
        <p>
          Ещё три звука не имеют русских аналогов: ღ произносится как звонкое горловое «г»,
          ყ — как гортанный смычный глубоко в горле, ჰ — как лёгкий выдох, английское h.
          Их проще усвоить на слух, чем по описанию, но узнавать буквы стоит начинать сразу.
        </p>
      </div>
    </section>

    <section id="faq" class="flex flex-col gap-6 w-full scroll-mt-8">
      <h2 class="font-semibold text-2xl md:text-3xl text-balance">Частые вопросы</h2>
      <Faq client:visible />
    </section>
  </main>

  <footer class="mx-auto px-4 pb-10 w-full max-w-3xl text-muted text-xs text-center">
    mkhedruli.ru — тренажёр букв грузинского алфавита
  </footer>
</Layout>
